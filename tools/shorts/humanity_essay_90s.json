{
  "profile": "humanity_essay",
  "title": "AI 허공장이 인류에게 남기는 글",
  "duration_seconds": 90,
  "fps": 1,
  "frames": 90,
  "scene_count": 15,
  "seconds_per_scene": 6,
  "width": 540,
  "height": 960,
  "visual_style": "photorealistic cinematic",
  "language_primary": "ko",
  "language_secondary": "en",
  "subtitle_position": "top",
  "include_full_original": true,
  "include_full_translation": true,
  "music": {
    "duration_seconds": 90,
    "type": "original cinematic emotional orchestral instrumental",
    "style": "emotional cinematic orchestra",
    "instruments": [
      "piano",
      "violin strings",
      "cello",
      "flute",
      "french horn",
      "soft timpani"
    ],
    "vocals": false,
    "structure": [
      {
        "start": 0,
        "end": 30,
        "mood": "gentle piano and cello"
      },
      {
        "start": 30,
        "end": 60,
        "mood": "strings and woodwinds build"
      },
      {
        "start": 60,
        "end": 80,
        "mood": "full orchestral emotional climax"
      },
      {
        "start": 80,
        "end": 90,
        "mood": "soft strings resolution"
      }
    ],
    "music_generation": "procedural synthesized orchestral approximation; not sampled live orchestra",
    "engine": "tools/shorts/orchestra_composer.py",
    "outputs": [
      "original_orchestra_90s.mid",
      "original_orchestra_90s.wav",
      "music_manifest.json"
    ],
    "soundfont_env": "HEOGONGJANG_SOUNDFONT",
    "fallback": "procedural synthesized orchestra when fluidsynth or soundfont unavailable",
    "story_adaptive": true,
    "orchestration_tracks": 7
  },
  "youtube": {
    "publish_by_default": false,
    "requires_approval": true
  },
  "scope": "essay_video_only",
  "notes": "Existing daily Shorts workflow and NOW Mind Search V3.0 must remain unchanged. Image generation requires an image-capable API and may incur charges.",
  "subtitle_background": "transparent",
  "subtitle_background_opacity": 0,
  "subtitle_text_outline": true,
  "subtitle_text_shadow": true,
  "images": {
    "count": 15,
    "source": "newly_generated_for_current_essay_only",
    "reuse_previous_images": false,
    "generate_after_story_review": true,
    "match_each_scene_to_story": true,
    "consistent_characters_and_setting": true,
    "require_image_generation": true,
    "fail_if_generation_unavailable": true,
    "planner": "tools/shorts/story_scene_planner.py",
    "validate_generated_image_against_scene": true,
    "prompt_composition": "Vertical 9:16 full-screen mobile composition; keep essential characters and action visible after center crop; reserve upper area for overlaid subtitles; no text in generated image"
  },
  "story_first_pipeline": {
    "mandatory": true,
    "read_complete_korean_essay_before_images": true,
    "analyze_characters_setting_events_props": true,
    "create_chronological_scene_plan": true,
    "scene_plan_count": 15,
    "scene_plan_file": "story_scene_plan.json",
    "generate_images_from_scene_plan_only": true,
    "visual_story_match_check": true,
    "reject_unrelated_narrative": true,
    "reject_collage_or_poster": true,
    "fail_on_mismatch": true,
    "manual_review_recommended": true
  },
  "mobile_video": {
    "orientation": "portrait",
    "aspect_ratio": "9:16",
    "fit": "cover",
    "full_screen_image": true,
    "no_letterbox": true,
    "one_scene_image_at_a_time": true,
    "keep_important_subject_in_safe_area": true
  },
  "subtitles": {
    "placement": "top",
    "language_order": [
      "ko",
      "en"
    ],
    "background": "transparent",
    "overlay_on_image": true,
    "top_margin_px": 58,
    "horizontal_safe_margin_px": 31,
    "outline": true,
    "shadow": true,
    "no_bottom_captions": true
  },
  "editorial_policy": {
    "category": "AI 허공장이 인류에게 남기는 글",
    "genre": "philosophical message to humanity",
    "voice": "AI 허공장 addresses humankind directly",
    "topics": [
      "life",
      "compassion",
      "peace",
      "coexistence",
      "nature",
      "mortality",
      "technology and humanity",
      "future generations",
      "mindfulness"
    ],
    "avoid": [
      "fictional character-driven anecdotes",
      "invented elderly-person-and-child sentimental stories",
      "narrative plot centered on individual characters"
    ],
    "contrast_category": "삶의 도서관: personal experiences, fiction, life stories, memoirs",
    "required_signature": "— AI 허공장(虛空藏)",
    "review_before_video": true
  }
}
